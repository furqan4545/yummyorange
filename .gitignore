# Build output
.build/
build/
.swiftpm/

# macOS and iCloud Desktop (iCloud puts deleted files back as "name 2")
.DS_Store
* 2.*
* 2

# Design explorations kept locally (the app icon and art live in Design/)
/*.png
/*.mp4
Website/unused-assets/

# Your own ffmpeg/cwebp copies in Tools/ (build.sh bundles them) stay local; the release scripts and the ffmpeg
# helper's build script are kept (its tarballs, work folder and zip, if it is run here, are not: the published copies
# live in Website/public/downloads/helpers/)
/Tools/*
!/Tools/updates/
!/Tools/helpers/
/Tools/helpers/sources/
/Tools/helpers/work/
/Tools/helpers/*.zip

# Hosting and secrets
.vercel/
*.key
*.p8
*.p12
update-signing-key*
.vercel
.env*
